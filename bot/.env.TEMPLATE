# ============================================================
# MAIA - bot/.env  (TEMPLATE - sem valores)
# Copiar para /opt/MAIA/bot/.env e preencher.
# Usado como EnvironmentFile pelos servicos maia-telegram-bot e maia-memory.
# ============================================================

# ---------- OBRIGATORIO (bot nao sobe sem isto) ----------
# Token do bot do Telegram (BotFather)
TELEGRAM_BOT_TOKEN=

# ---------- IDENTIDADE / ACESSO (fortemente recomendado) ----------
# IDs do Telegram autorizados a falar com a MAIA (separados por virgula)
ALLOWED_USERS=
# ID do Telegram do dono/admin (gates de admin e STOP). Se vazio, usa o 1o de ALLOWED_USERS
ADMIN_CHAT_ID=
# Nome do agente e do dono (identidade vem tambem do CLAUDE.md)
AGENTE_NAME=MAIA
OWNER_NAME=

# ---------- TMUX (sessao onde o Claude Code roda) ----------
# Nome da sessao tmux onde a MAIA (Claude Code) roda
TMUX_SESSION=maia-master
# Usuario do SO que roda a sessao
TMUX_USER=maia
# Socket tmux (uid do usuario maia; ajuste se o uid nao for 1000)
TMUX_SOCKET=/tmp/tmux-1000/default

# ---------- CHAVES DE IA ----------
# GEMINI_API_KEY e usada pelo bot E pelo memory-service (busca semantica porta 3007)
GEMINI_API_KEY=
# Groq Whisper (transcricao de audio, free tier whisper-large-v3-turbo)
GROQ_API_KEY=
# OpenAI (fallback de transcricao e outros usos)
OPENAI_API_KEY=
# ElevenLabs (voz, opcional se VOICE_ENGINE=gemini)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------- OPCIONAIS (tem default no codigo; preencher so se quiser sobrescrever) ----------
# Voz / TTS
VOICE_ENGINE=gemini
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
# Estilo de narracao prependado ao texto (sotaque/tom). Vazio = default do codigo
NAIA_VOICE_STYLE=
# Imagem (geracao e edicao via Gemini/Imagen)
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
GEMINI_DEFAULT_ASPECT=1:1
GEMINI_EDIT_MODEL=gemini-2.5-flash-image
# Timing / watchdog (NAIA_TIMEOUT_SECONDS mantido com este nome pois o bot.py le assim)
DEBOUNCE_SECONDS=8
NAIA_TIMEOUT_SECONDS=600
HEALTHCHECK_INTERVAL=120
HEALTHCHECK_ALERT_THROTTLE=1800
# Auto-aprovacao de prompts do Claude Code
AUTO_APPROVE_ENABLED=1
AUTO_APPROVE_CAP_PER_HOUR=50
AUTO_APPROVE_WINDOW_SEC=3600
AUTO_APPROVE_COOLDOWN_SEC=3600
CLAUDE_PROMPT_POLL_INTERVAL=2
CLAUDE_PROMPT_DEDUP_TTL=60
# Grupo: se true, qualquer membro do grupo pode falar (sem whitelist). Default false
NAIA_GROUP_OPEN_MEMBERSHIP=false

# ---------- TRANSCRICAO (Whisper) ----------
# Provider padrao: local (faster-whisper) ou api (Groq->OpenAI)
WHISPER_DEFAULT_PROVIDER=local
# Modelo do faster-whisper local (tiny/base/small/medium/large-v3)
WHISPER_LOCAL_MODEL=medium
# Se 1, permite fallback PAGO pra OpenAI quando Groq falha. Default 0
WHISPER_OPENAI_FALLBACK=0

# ---------- GOOGLE CALENDAR ----------
# Calendario padrao (primary) e timezone
CALENDAR_PRIMARY_ID=primary
CALENDAR_TZ=America/Sao_Paulo

# ---------- REMOCAO DE FUNDO (rembg) ----------
# Modelo de segmentacao para remover fundo de imagens
REMBG_MODEL=u2net
